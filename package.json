{
  "name": "isp-ui-template",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "start": "vite",
    "typecheck": "tsc --noEmit && tsc -p tsconfig.node.json",
    "lint": "eslint src bin generator scripts --max-warnings 0",
    "format": "prettier --write src scripts bin generator vite.config.ts",
    "format:check": "prettier --check src scripts bin generator vite.config.ts",
    "test": "node --test scripts/*.test.mjs",
    "check": "npm run typecheck && npm run lint && npm run format:check && npm test",
    "build": "npm run typecheck && vite build && node generateVersionFile.cjs",
    "preview": "vite preview",
    "prepare": "husky || true",
    "create": "node bin/create-isp-ui.mjs",
    "test:docker": "node generator/verify-deployment.mjs"
  },
  "dependencies": {
    "react": "^19.2.3",
    "react-dom": "^19.2.3",
    "react-router-dom": "^7.18.4"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.2",
    "@trivago/prettier-plugin-sort-imports": "^6.0.2",
    "@types/node": "^25.0.10",
    "@types/react": "^19.2.9",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^5.1.2",
    "eslint": "^9.39.2",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-react-hooks": "^7.0.1",
    "eslint-plugin-react-refresh": "^0.4.26",
    "globals": "^17.0.0",
    "husky": "^9.1.7",
    "lint-staged": "^16.2.7",
    "prettier": "^3.8.1",
    "sass": "^1.97.3",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.53.1",
    "vite": "^7.3.1",
    "vite-plugin-svgr": "^4.5.0",
    "vite-tsconfig-paths": "^6.0.4"
  },
  "lint-staged": {
    "**/*.{js,jsx,ts,tsx}": [
      "npx prettier --write",
      "npx eslint --fix"
    ]
  },
  "engines": {
    "node": ">=24 <25"
  },
  "config": {
    "appName": "ISP UI"
  }
}
